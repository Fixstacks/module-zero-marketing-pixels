<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="zero_pixels" translate="label" type="text" sortOrder="31" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Marketing Pixels</label>
            <tab>zero</tab>
            <resource>Zero_MarketingPixels::config</resource>
            <group id="meta" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Meta Pixel (Facebook, Instagram)</label>
                <comment>PageView, ViewContent, Search, AddToCart, AddToWishlist, InitiateCheckout, AddPaymentInfo, Purchase, CompleteRegistration. Loads after the visitor accepts marketing cookies.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="pixel_id" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Pixel ID</label>
                    <comment>Events Manager > Data sources > your pixel: the number, e.g. 123456789012345.</comment>
                    <validate>validate-digits</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="tiktok" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>TikTok Pixel</label>
                <comment>Page views, ViewContent, Search, AddToCart, AddToWishlist, InitiateCheckout, AddPaymentInfo, CompletePayment, CompleteRegistration. Loads after the visitor accepts marketing cookies.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="pixel_id" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Pixel ID</label>
                    <comment>TikTok Ads Manager > Assets > Events > Web events: the pixel's ID, e.g. C4ABCDEFGH1234567890.</comment>
                    <validate>validate-alphanum</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="pinterest" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Pinterest Tag</label>
                <comment>Page visits, view category, search, add to cart, checkout (the order), sign-up. Loads after the visitor accepts marketing cookies.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="tag_id" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Tag ID</label>
                    <comment>Pinterest Ads > Conversions > Tag manager: the tag's number, e.g. 2612345678901.</comment>
                    <validate>validate-digits</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="clarity" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Microsoft Clarity</label>
                <comment>Heatmaps and session recordings. Loads after the visitor accepts analytics cookies; Clarity masks what visitors type.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="project_id" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Project ID</label>
                    <comment>clarity.microsoft.com > your project > Settings > Overview: the project ID, e.g. abcd1234ef.</comment>
                    <validate>validate-alphanum</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
