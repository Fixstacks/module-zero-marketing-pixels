    The pixels in Zero_Consent's banner, and as a user of Zero_GoogleAnalytics'
    e-commerce events.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Zero\Consent\Model\Trackers">
        <arguments>
            <argument name="trackers" xsi:type="array">
                <item name="marketing_pixels" xsi:type="object">Zero\MarketingPixels\Model\Tracker</item>
            </argument>
        </arguments>
    </type>
    <type name="Zero\GoogleAnalytics\Model\Config">
        <arguments>
            <argument name="listeners" xsi:type="array">
                <item name="marketing_pixels" xsi:type="object">Zero\MarketingPixels\Model\Tracker</item>
            </argument>
        </arguments>
    </type>
</config>
