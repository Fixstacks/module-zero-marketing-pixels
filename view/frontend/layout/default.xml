    SPDX-License-Identifier: OSL-3.0 OR AFL-3.0

    Every page: the pixels' settings + pixels.js (head). The events come from
    Zero_GoogleAnalytics' analytics.js.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="head.additional">
            <block name="zero.pixels.head" template="Zero_MarketingPixels::head.phtml">
                <arguments>
                    <argument name="pixels" xsi:type="object">Zero\MarketingPixels\ViewModel\Pixels</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
